{
  "name": "ESP-NOW-MIDI",
  "version": "0.18.0",
  "description": "Arduino library for sending and receiving MIDI messages via the ESP-NOW protocol.",
  "keywords": [
    "midi",
    "esp-now",
    "esp32",
    "wireless",
    "usb-midi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grantler-instruments/ESP-NOW-MIDI.git"
  },
  "authors": [
    {
      "name": "Thomas Geissl",
      "email": "thomas.geissl@gmail.com",
      "maintainer": true
    }
  ],
  "license": "LGPL-3.0",
  "homepage": "https://github.com/grantler-instruments/ESP-NOW-MIDI",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "esp_now_midi.h",
    "enomik_client.h",
    "include/enomik_io.h",
    "include/esp_now_midi_helpers.h"
  ],
  "export": {
    "exclude": [
      "examples_idf",
      ".arduino-build",
      "benchmarks",
      "scripts",
      "test",
      "examples",
      "docs",
      ".github",
      "platformio",
      "mkdocs.yml",
      "Doxyfile"
    ]
  },
  "dependencies": [
    {
      "name": "Adafruit TinyUSB Library",
      "owners": "adafruit"
    }
  ]
}

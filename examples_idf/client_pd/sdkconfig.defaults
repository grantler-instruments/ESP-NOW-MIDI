# Defaults for the client_pd example (ESP32-S3 + PSRAM recommended).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Pd allocates a lot; let large blocks go to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# USB MIDI class in esp_tinyusb (HAS_USB_MIDI on S2/S3).
CONFIG_TINYUSB_MIDI_COUNT=1

# include/esp_now_midi_gpio.h still uses the legacy touch_pad API.
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

#N canvas 100 100 1250 950 12;
#X declare -path enomik;
#X obj 20 20 declare -path enomik;
#X text 20 55 enomik SysEx configuration from Pd. Every abstraction takes the MIDI port as argument (default 1). See docs/enomik-sysex-protocol.md, f 100;
#X msg 20 110 bang;
#X obj 260 110 enomik.get_version;
#X text 500 110 library version, f 45;
#X msg 20 150 bang;
#X obj 260 150 enomik.get_config;
#X text 500 150 pins + peers + flags + name \, then config_done, f 45;
#X msg 20 190 bang;
#X obj 260 190 enomik.get_mac;
#X text 500 190 device MAC, f 45;
#X msg 20 230 3 2 0 1 144 60 0 127;
#X obj 260 230 enomik.set_pin_config;
#X text 500 230 pin 3 INPUT_PULLUP -> note on 60 \, channel 1, f 45;
#X msg 20 270 7;
#X obj 260 270 enomik.get_pin_config;
#X text 500 270 one pin, f 45;
#X msg 20 310 7;
#X obj 260 310 enomik.delete_pin_config;
#X text 500 310 delete one pin, f 45;
#X msg 20 350 bang;
#X obj 260 350 enomik.get_all_pin_configs;
#X text 500 350 all pins \, then stream_end pins, f 45;
#X msg 20 390 bang;
#X obj 260 390 enomik.clear_pin_configs;
#X text 500 390 delete all pins, f 45;
#X msg 20 430 symbol 84:F7:03:F2:54:62;
#X obj 260 430 enomik.add_peer;
#X text 500 430 pair with a dongle (or 6 octets), f 45;
#X msg 20 470 0;
#X obj 260 470 enomik.get_peer;
#X text 500 470 peer in slot 0, f 45;
#X msg 20 510 bang;
#X obj 260 510 enomik.get_all_peers;
#X text 500 510 all peers \, then stream_end peers, f 45;
#X msg 20 550 pad left;
#X obj 260 550 enomik.set_name;
#X text 500 550 max 16 chars \; bang clears, f 45;
#X msg 20 590 bang;
#X obj 260 590 enomik.get_name;
#X text 500 590 client name, f 45;
#X obj 20 630 tgl 25 0 empty empty empty 17 7 0 10 #e4e4e4 #4d4d4d #373737 0 1;
#X obj 260 630 enomik.set_midi_loopback;
#X text 500 630 soft MIDI thru, f 45;
#X msg 20 670 bang;
#X obj 260 670 enomik.get_midi_loopback;
#X obj 20 710 tgl 25 0 empty empty empty 17 7 0 10 #e4e4e4 #4d4d4d #373737 0 1;
#X obj 260 710 enomik.set_power_save;
#X text 500 710 less power \, more latency, f 45;
#X msg 20 750 bang;
#X obj 260 750 enomik.get_power_save;
#X msg 20 790 4 1 50;
#X obj 260 790 enomik.set_raw_stream;
#X text 500 790 pin enable interval_ms \; keepalive built in, f 45;
#X msg 20 830 4 0 0;
#X text 500 830 stop raw stream, f 45;
#X msg 20 870 bang;
#X obj 260 870 enomik.reset;
#X text 500 870 clear everything (careful), f 45;
#X text 880 150 replies, f 45;
#X obj 880 150 enomik.recv;
#X obj 880 150 enomik.parse;
#X obj 880 190 print enomik;
#X obj 900 150 print enomik.error_list;
#X text 920 260 print every sent frame, f 45;
#X obj 880 260 tgl 25 0 empty empty empty 17 7 0 10 #e4e4e4 #4d4d4d #373737 0 1;
#X obj 880 300 s enomik.debug;
#X connect 2 0 3 0;
#X connect 5 0 6 0;
#X connect 8 0 9 0;
#X connect 11 0 12 0;
#X connect 14 0 15 0;
#X connect 17 0 18 0;
#X connect 20 0 21 0;
#X connect 23 0 24 0;
#X connect 26 0 27 0;
#X connect 29 0 30 0;
#X connect 32 0 33 0;
#X connect 35 0 36 0;
#X connect 38 0 39 0;
#X connect 41 0 42 0;
#X connect 44 0 45 0;
#X connect 46 0 47 0;
#X connect 49 0 50 0;
#X connect 51 0 52 0;
#X connect 54 0 52 0;
#X connect 56 0 57 0;
#X connect 60 0 61 0;
#X connect 61 0 62 0;
#X connect 60 1 63 0;
#X connect 65 0 66 0;

#N canvas 100 100 900 700 12;
#X obj 20 20 inlet;
#X obj 95 20 r enomik.debug;
#X obj 20 60 list prepend 240 125 0 19;
#X obj 20 100 list append 247;
#X obj 20 140 t a a;
#X obj 275 60 spigot;
#X obj 185 100 print enomik.send;
#X obj 20 180 t b b b a;
#X obj 20 220 list;
#X obj 86 220 until;
#X obj 20 260 list split 1;
#X obj 161 220 list prepend;
#X obj 158 260 t a a;
#X obj 299 220 list;
#X obj 20 300 midiout \$1;
#X text 398 20 enomik.send [port], f 45;
#X text 398 45 Frames a request as SysEx and sends it to [midiout]., f 45;
#X text 398 90 Inlet: list CMD payload... -> F0 7D MAJOR MINOR CMD payload... F7, f 45;
#X text 398 135 Protocol version 0.19 - keep in sync with include/version.h, f 45;
#X text 398 180 Port: MIDI out device number (default 1)., f 45;
#X text 398 205 Debug: send 1 to enomik.debug to print every frame., f 45;
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;

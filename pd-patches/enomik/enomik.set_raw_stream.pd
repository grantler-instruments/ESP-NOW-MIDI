#X text 344 20 enomik.set_raw_stream [port], f 45;
#X text 344 45 Inlet: pin enable interval_ms, f 45;
#X text 344 70 pin 127 = every configured input pin. interval 0 = 50 ms \, min 20 ms., f 45;
#X text 344 115 While on \, re-sends every 5 s as keepalive (firmware stops after 10 s of silence)., f 45;
#X text 344 160 Replies: raw_stream ... \, then raw frames (see enomik.parse)., f 45;

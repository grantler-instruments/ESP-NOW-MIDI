#N canvas 100 100 900 700 12;
#X obj 20 20 inlet;
#X obj 20 60 unpack f f f f f f f f;
#X obj 20 100 pack f f f f f f f f;
#X obj 230 100 moses 128;
#X obj 20 140 / 2;
#X obj 80 140 list prepend 1;
#X obj 20 180 enomik.send \$1;
#X text 371 20 enomik.set_pin_config [port], f 45;
#X text 371 45 Inlet: pin mode threshold channel type note min max, f 45;
#X text 371 90 mode: 0 INPUT \, 1 OUTPUT \, 2 INPUT_PULLUP \, 3 ANALOG_INPUT \, 4 ANALOG_OUTPUT \, 5 INPUT_TOUCH, f 45;
#X text 371 135 threshold: touch only \, 0 = continuous \, 1-127 = on/off at % change, f 45;
#X text 371 180 channel: 1-16, f 45;
#X text 371 205 type: MIDI status 128 note off \, 144 note on \, 176 CC \, 192 program change (or already halved: 64 72 88 96), f 45;
#X text 371 270 note: note or CC number. min/max: mapped range, f 45;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 1 2 2 2;
#X connect 1 3 2 3;
#X connect 1 4 3 0;
#X connect 3 0 2 4;
#X connect 3 1 4 0;
#X connect 4 0 2 4;
#X connect 1 5 2 5;
#X connect 1 6 2 6;
#X connect 1 7 2 7;
#X connect 2 0 5 0;
#X connect 5 0 6 0;

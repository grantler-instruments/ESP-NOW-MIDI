PROJECT_NAME           = "ESP-NOW MIDI"
PROJECT_BRIEF          = "Arduino library for sending and receiving MIDI messages via ESP-NOW."
# PROJECT_NUMBER is injected from version.h by docs/generate.sh — do not set by hand.
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = .doxygen

INPUT                  = include . README.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
# Root esp_now_midi*.h shims are Arduino entry points; document include/ instead.
EXCLUDE                = esp_now_midi.h esp_now_midi_log.h esp_now_midi_wifi.h esp_now_midi_helpers.h
EXCLUDE_PATTERNS       = .doxygen/* docs/* test/*
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

# Keep output filenames identical on macOS and Linux. Without this, Doxygen
# defaults to SYSTEM: Linux preserves camelCase (classenomik_1_1Client) while
# macOS mangles to underscores (classenomik_1_1_client), which breaks handwritten
# links and CI --strict MkDocs builds.
CASE_SENSE_NAMES       = NO

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

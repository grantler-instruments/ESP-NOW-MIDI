+#error PD_FLOAT_DSP requires 32-bit Pd samples
+#endif
+/* Bounded phase avoids double bit tricks. Compensation preserves small
+   increments; the residual is carried in the existing double state per block. */
+static inline float pd_float_wrap(float phase, float period)
+{
+    if (!isfinite(phase)) return 0.0f;
+    if (phase >= 0.0f && phase < period) return phase;
+    phase = fmodf(phase, period);
+    if (phase < 0.0f) phase += period;
+    return phase < period ? phase : 0.0f;
+}
+
+static inline void pd_float_advance(float *phase, float *error,
+    float increment, float period)
+{
+    float y = increment - *error;
+    float next = *phase + y;
+    *error = (next - *phase) - y;
+    if (next < 0.0f)
+    {
+        float wrapped;
+        if (next < -period) next = fmodf(next, period);
+        wrapped = next + period;
+        /* Adding the period can round; carry that error as well. */
+        *error += (wrapped-period)-next;
+        *phase = wrapped < period ? wrapped : 0.0f;
+    }
+    else *phase = pd_float_wrap(next, period);
+}
+#endif

# Current DSP routines only; legacy compatibility paths stay in flash.
# noflash maps function text and its associated literal sections.
[mapping:libpd_hot_dsp]
archive: liblibpd.a
entries:
    if LIBPD_IRAM_DSP = y:
        d_ugen:dsp_tick (noflash)
        d_ugen:zero_perform (noflash)
        d_ugen:zero_perf8 (noflash)
        d_ugen:plus_perform (noflash)
        d_ugen:plus_perf8 (noflash)
        d_ugen:copy_perform (noflash)
        d_ugen:copy_perf8 (noflash)
        d_ugen:scalarcopy_perform (noflash)
        d_ugen:scalarcopy_perf8 (noflash)
        d_arithmetic:log_tilde_perform (noflash)
        d_arithmetic:log_tilde_perform_reversescalar (noflash)
        d_arithmetic:log_tilde_perform_scalar (noflash)
        d_arithmetic:minus_perf8 (noflash)
        d_arithmetic:minus_perform (noflash)
        d_arithmetic:pow_tilde_perform (noflash)
        d_arithmetic:pow_tilde_perform_reversescalar (noflash)
        d_arithmetic:pow_tilde_perform_scalar (noflash)
        d_arithmetic:reversescalarminus_perf8 (noflash)
        d_arithmetic:reversescalarminus_perform (noflash)
        d_arithmetic:scalarminus_perf8 (noflash)
        d_arithmetic:scalarminus_perform (noflash)
        d_arithmetic:scalarplus_perf8 (noflash)
        d_arithmetic:scalarplus_perform (noflash)
        d_arithmetic:scalartimes_perf8 (noflash)
        d_arithmetic:scalartimes_perform (noflash)
        d_arithmetic:times_perf8 (noflash)
        d_arithmetic:times_perform (noflash)
        d_filter:siglop_perf_scalar (noflash)
        d_filter:siglop_perf_vector (noflash)
        d_filter:sighip_perform (noflash)
        d_filter:sigbiquad_perform (noflash)
        d_ctl:line_tilde_perform (noflash)
        d_ctl:vline_tilde_perform (noflash)
        d_osc:phasor_perform (noflash)
        d_osc:osc_perform (noflash)
        d_osc:cos_perform (noflash)
        d_osc:tabosc4_tilde_perform (noflash)
        d_osc:sigvcf_perform (noflash)
        d_array:tabread4_tilde_perform (noflash)
        d_delay:sigdelwrite_perform (noflash)
        d_delay:sigdelread_perform (noflash)
        d_delay:sigvd_perform (noflash)
        d_math:dbtopow_tilde_perform (noflash)
        d_math:dbtorms_tilde_perform (noflash)
        d_math:exp_tilde_perform (noflash)
        d_math:ftom_tilde_perform (noflash)
        d_math:mtof_tilde_perform (noflash)
        d_math:powtodb_tilde_perform (noflash)
        d_math:rmstodb_tilde_perform (noflash)
        d_math:sigrsqrt_perform (noflash)
        d_math:sigrsqrt_perform8 (noflash)
        d_math:sigsqrt_perform (noflash)
        d_math:sigsqrt_perform8 (noflash)
        m_sched:sched_tick (noflash)
        z_libpd:libpd_process_float (noflash)

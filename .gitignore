__pycache__/

# Local build output (Arduino IDE 2.x, CMake, etc.)
build/
test/idf/build/
test/idf/sdkconfig
test/idf/sdkconfig.old
test/idf/dependencies.lock
test/idf/managed_components/

# ESP-IDF Component Manager downloads (regenerated by idf.py build)
examples_idf/**/managed_components/
# Target-pinned; regenerated per idf.py set-target / build
examples_idf/**/dependencies.lock

# Per-target; generated from sdkconfig.defaults by idf.py set-target / build
examples_idf/**/sdkconfig
examples_idf/**/sdkconfig.old

# PlatformIO
.pio/

# Arduino CLI / IDE
.arduino-build/

.vscode
.DS_Store
.venv/
.tools/
.doxygen/
docs/.doxygen/
docs/api/
site/
.docs-serve/
